# Copy to .env and fill in. .env is gitignored — never commit it.

# MongoDB holding MUTUALFUND_DATA / MUTUALFUND_NAV (read-only access is enough)
MF_MONGO_URI=mongodb://<user>:<password>@localhost:27018/?authSource=admin&directConnection=true

# NVIDIA API key for FLUX.1-dev background art (scripts/flux_nvidia.py) — https://build.nvidia.com
NVIDIA_API_KEY=

# Google Gemini key for Nano Banana images (optional) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the image model (default gemini-3-pro-image-preview = Nano Banana Pro)
# NANO_BANANA_MODEL=gemini-2.5-flash-image
